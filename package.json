{
  "name": "distrito-stella-del-mar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build && node scripts/copy-standalone-public.mjs",
    "build:godaddy": "node --max-old-space-size=3072 ./node_modules/next/dist/bin/next build && node scripts/copy-standalone-public.mjs",
    "postbuild:public": "node scripts/copy-standalone-public.mjs",
    "start": "next start -H 0.0.0.0",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-floors": "tsx scripts/seed-floor-units.ts",
    "db:studio": "prisma studio",
    "db:dump": "tsx scripts/export-sql-dump.ts",
    "db:pack-uploads": "tsx scripts/pack-uploads.ts",
    "deploy:prepare": "npm ci && npm run db:push && npm run build",
    "deploy:copy-public": "node scripts/copy-standalone-public.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.42.2",
    "isomorphic-dompurify": "^3.19.0",
    "lucide-react": "^1.26.0",
    "next": "15.5.21",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.82.0",
    "resend": "^6.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.21",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
