# Sitio de PRODUCCIÓN — GoDaddy
# Copiar a .env en el servidor de producción (NO subir a git)

NEXT_PUBLIC_SITE_ENV=production
NEXT_PUBLIC_SITE_URL=https://distritostelladelmar.com

NEXT_PUBLIC_CONTACT_EMAIL=info@distritostelladelmar.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

NEXT_PUBLIC_MAPS_URL=https://www.google.com/maps?q=15.81699333534756,-87.93110169660831
NEXT_PUBLIC_MAP_LAT=15.81699333534756
NEXT_PUBLIC_MAP_LNG=-87.93110169660831

NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TIKTOK_URL=

RESEND_API_KEY=
CONTACT_FROM_EMAIL=Distrito Stella del Mar <noreply@distritostelladelmar.com>
CONTACT_TO_EMAIL=info@distritostelladelmar.com

# Base de datos
# Opción A (recomendada en hosting con BD adjunta / Secrets):
#   DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD — el panel las inyecta.
#   La app arma DATABASE_URL sola; no hace falta definir DATABASE_URL.
# Opción B (manual / cPanel clásico):
# DATABASE_URL="mysql://usuario:PASSWORD@127.0.0.1:3306/distrito_cms"

# DB_HOST=
# DB_PORT=3306
# DB_NAME=distrito_cms
# DB_USER=distrito
# DB_PASSWORD=

DATABASE_URL="mysql://usuario_prod:PASSWORD@127.0.0.1:3306/distrito_prod"

ADMIN_SESSION_SECRET=cambiar-secreto-largo-produccion
ADMIN_EMAIL=admin@distritostelladelmar.com
ADMIN_PASSWORD=cambiar-password-muy-seguro

# CMS media (obligatorio en GoDaddy Git-connected / disco solo lectura)
# Cree un Blob Store en https://vercel.com/dashboard → Storage → Blob
# y pegue el token de lectura/escritura:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Sitio público: true = abierto | false = solo admin logueado
# Si se omite, manda Admin → Ajustes → «Sitio en vivo»
# SITE_LIVE=false

PORT=3000
HOST=0.0.0.0
