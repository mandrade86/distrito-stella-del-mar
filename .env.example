# Public site URL (canonical / sitemap / OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# production | staging — staging no se indexa en Google
NEXT_PUBLIC_SITE_ENV=development

# Contact (leave empty or PENDING_* until confirmed)
NEXT_PUBLIC_CONTACT_EMAIL=info@distritostelladelmar.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Maps
NEXT_PUBLIC_MAPS_URL=https://www.google.com/maps?q=15.81699333534756,-87.93110169660831
NEXT_PUBLIC_MAP_LAT=15.81699333534756
NEXT_PUBLIC_MAP_LNG=-87.93110169660831

# Social
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Contact form (Resend)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Distrito Stella del Mar <onboarding@resend.dev>
CONTACT_TO_EMAIL=info@distritostelladelmar.com

# MySQL CMS (Prisma)
DATABASE_URL="mysql://distrito:distrito@localhost:3306/distrito_cms"

# Admin
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@distritostelladelmar.com
ADMIN_PASSWORD=Admin123!

# Puerto (GoDaddy cPanel / PM2 lo suelen inyectar)
PORT=3000
HOST=0.0.0.0
